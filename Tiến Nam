<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CYBER PANEL // MOCKUP</title>
<style>
  :root {
    --neon-cyan: #00fff9;
    --neon-pink: #ff00c8;
    --neon-green: #39ff14;
    --bg-dark: #050510;
    --panel-bg: rgba(10, 10, 25, 0.85);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Courier New', monospace;
    background: var(--bg-dark);
    color: var(--neon-cyan);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* Lưới nền cyberpunk */
    background-image:
      linear-gradient(rgba(0, 255, 249, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 249, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  /* Hiệu ứng scanline */
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15),
      rgba(0, 0, 0, 0.15) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    z-index: 999;
  }

  .panel {
    width: 420px;
    background: var(--panel-bg);
    border: 2px solid var(--neon-cyan);
    border-radius: 8px;
    padding: 25px;
    position: relative;
    box-shadow:
      0 0 20px rgba(0, 255, 249, 0.4),
      inset 0 0 30px rgba(0, 255, 249, 0.05);
    backdrop-filter: blur(4px);
    animation: panelGlow 3s ease-in-out infinite alternate;
  }

  @keyframes panelGlow {
    from { box-shadow: 0 0 20px rgba(0, 255, 249, 0.4), inset 0 0 30px rgba(0, 255, 249, 0.05); }
    to   { box-shadow: 0 0 35px rgba(255, 0, 200, 0.5), inset 0 0 40px rgba(255, 0, 200, 0.08); }
  }

  /* Góc trang trí */
  .panel::before, .panel::after {
    content: "";
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--neon-pink);
  }
  .panel::before { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .panel::after  { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .header {
    text-align: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px dashed var(--neon-pink);
  }

  .header h1 {
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--neon-pink);
    text-shadow: 0 0 10px var(--neon-pink);
    animation: flicker 4s infinite;
  }

  @keyframes flicker {
    0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { opacity: 1; }
    20%, 24%, 55% { opacity: 0.4; }
  }

  .header .sub {
    font-size: 10px;
    color: var(--neon-cyan);
    opacity: 0.7;
    margin-top: 5px;
    letter-spacing: 1px;
  }

  /* Trạng thái hệ thống */
  .status-bar {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    margin-bottom: 18px;
    padding: 8px 10px;
    background: rgba(0, 255, 249, 0.05);
    border-left: 3px solid var(--neon-green);
  }
  .status-bar .dot {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--neon-green);
    box-shadow: 0 0 8px var(--neon-green);
    animation: pulse 1.5s infinite;
    margin-right: 6px;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Các mục toggle */
  .feature {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 10px;
    margin-bottom: 10px;
    background: rgba(0, 255, 249, 0.03);
    border: 1px solid rgba(0, 255, 249, 0.2);
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  .feature:hover {
    border-color: var(--neon-cyan);
    background: rgba(0, 255, 249, 0.08);
    transform: translateX(3px);
  }
  .feature .label {
    font-size: 13px;
    letter-spacing: 1px;
  }
  .feature .label small {
    display: block;
    font-size: 9px;
    opacity: 0.6;
    margin-top: 3px;
  }

  /* Toggle switch */
  .toggle {
    position: relative;
    width: 50px;
    height: 24px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .toggle input { display: none; }
  .toggle .slider {
    position: absolute;
    inset: 0;
    background: #1a1a2e;
    border: 1px solid var(--neon-cyan);
    border-radius: 12px;
    transition: 0.3s;
  }
  .toggle .slider::before {
    content: "";
    position: absolute;
    width: 16px; height: 16px;
    left: 3px; top: 3px;
    background: var(--neon-cyan);
    border-radius: 50%;
    transition: 0.3s;
    box-shadow: 0 0 8px var(--neon-cyan);
  }
  .toggle input:checked + .slider {
    background: rgba(57, 255, 20, 0.15);
    border-color: var(--neon-green);
  }
  .toggle input:checked + .slider::before {
    transform: translateX(26px);
    background: var(--neon-green);
    box-shadow: 0 0 10px var(--neon-green);
  }

  /* Nút kích hoạt chính */
  .activate-btn {
    width: 100%;
    margin-top: 20px;
    padding: 15px;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    color: var(--neon-cyan);
    background: transparent;
    border: 2px solid var(--neon-cyan);
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }
  .activate-btn:hover {
    color: var(--bg-dark);
    background: var(--neon-cyan);
    box-shadow: 0 0 25px var(--neon-cyan);
  }
  .activate-btn.active {
    color: var(--bg-dark);
    background: var(--neon-green);
    border-color: var(--neon-green);
    box-shadow: 0 0 30px var(--neon-green);
    animation: activeGlow 1.2s infinite alternate;
  }
  @keyframes activeGlow {
    from { box-shadow: 0 0 20px var(--neon-green); }
    to   { box-shadow: 0 0 45px var(--neon-green); }
  }

  /* Log cuối panel */
  .log {
    margin-top: 15px;
    font-size: 10px;
    color: var(--neon-green);
    opacity: 0.8;
    height: 16px;
    overflow: hidden;
    white-space: nowrap;
  }

  /* Cảnh báo demo */
  .demo-warning {
    position: fixed;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: var(--neon-pink);
    letter-spacing: 1px;
    opacity: 0.8;
    text-align: center;
    padding: 5px 15px;
    border: 1px dashed var(--neon-pink);
    border-radius: 4px;
    background: rgba(0,0,0,0.7);
  }
</style>
</head>
<body>

<div class="panel">
  <div class="header">
    <h1>// Tiến Nam
 //</h1>
    <div class="sub">v2.0.77 — [MOCKUP UI DEMO]</div>
  </div>

  <div class="status-bar">
    <span><span class="dot"></span>SYSTEM ONLINE</span>
    <span id="clock">00:00:00</span>
  </div>

  <!-- Feature 1 -->
  <div class="feature">
    <div class="label">
      NO RECOIL
      <small>// ổn định tâm bắn</small>
    </div>
    <label class="toggle">
      <input type="checkbox" id="tglRecoil">
      <span class="slider"></span>
    </label>
  </div>

  <!-- Feature 2 -->
  <div class="feature">
    <div class="label">
      Nhẹ tâm
      <small>// nhẹ tâm hơn</small>
    </div>
    <label class="toggle">
      <input type="checkbox" id="tglFov">
      <span class="slider"></span>
    </label>
  </div>

  <!-- Feature 3 -->
  <div class="feature">
    <div class="label">
      AIM SMOOTH
      <small>// làm mượt chuyển động</small>
    </div>
    <label class="toggle">
      <input type="checkbox" id="tglSmooth">
      <span class="slider"></span>
    </label>
  </div>

  <!-- Nút kích hoạt chính -->
  <button class="activate-btn" id="activateBtn">
    KÍCH HOẠT HỆ THỐNG
  </button>

  <div class="log" id="log">> sẵn sàng...</div>
</div>

<script>
 t  // ==== Đồng hồắt hệ thống ====
  const clockEl = document.getElementById');
('clock');
  setInterval(() => {
       const d = new Date();
    clockEl.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()]
      .map(n => String(n).padStart(2, '0')).join(':');
  }, 1000);

  // ==== Log helper ====
  const logEl = document.getElementById('log');
  function log(msg) {
    logEl.textContent = '> ' + msg;
  }

  // ==== Các toggle con ====
  const toggles = {
    recoil: document.getElementById('tglRecoil'),
    fov: document.getElementById('tglFov'),
    smooth: document.getElementById('tglSmooth')
  };

  Object.entries(toggles).forEach(([key, el]) => {
    el.addEventListener('change', () => {
      log(`${key.toUpperCase()}: ${el.checked ? 'ENABLED' : 'DISABLED'}`);
    });
  });

  // ==== Nút kích hoạt hệ thống ====
  const activateBtn = document.getElementById('activateBtn');
  let systemActive = false;

  activateBtn.addEventListener('click', () => {
    systemActive = !systemActive;

    if (systemActive) {
      activateBtn.textContent = 'HỆ THỐNG: ACTIVE';
      activateBtn.classList.add('active');
      log('hệ thống đã kích hoạt [giả lập]');
    } else {
      activateBtn.textContent = 'KÍCH HOẠT HỆ THỐNG';
      activateBtn.classList.remove('active');
      log('hệ thống }
  });

  // ==== Hiệu ứng FOV circle nếu bật (chỉ trang trí) ====
  // Vẽ vòng tròn bằng div để demo (không liên quan game)
  toggles.fov.addEventListener('change', () => {
    let circle = document.getElementById('fovCircleDemo');
    if (toggles.fov.checked && !circle) {
      circle = document.createElement('div');
      circle.id = 'fovCircleDemo';
      Object.assign(circle.style, {
        position: 'fixed',
        width: '200px',
        height: '200px',
        border: '2px dashed rgba(0,255,249,0.6)',
        borderRadius: '50%',
        top: '50%',
        left: '50%',
        transform: 'translate(-50%,-50%)',
        pointerEvents: 'none',
        boxShadow: '0 0 20px rgba(0,255,249,0.3)',
        zIndex: 1000,
        transition: 'all 0.3s'
      });
      document.body.appendChild(circle);
      log('Nhẹ tâm: hiển thị (demo)');
    } else if (circle && !toggles.fov.checked) {
      circle.remove();
      log('Nhẹ tâm: ẩn');
    }
  });
</script>
</body>
</html>